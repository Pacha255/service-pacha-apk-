rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "servicepacha43@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. PRODUITS : SEUL L'ADMINISTRATEUR PEUT AJOUTER, MODIFIER OU SUPPRIMER
    // Les clients peuvent uniquement consulter les produits.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. CATÉGORIES : SEUL L'ADMINISTRATEUR PEUT GÉRER LES CATÉGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. COMMANDES : Clients créent et lisent leurs commandes, l'admin voit et gère toutes les commandes
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. UTILISATEURS : Gestion des comptes et protection du rôle administrateur
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == "client";
      allow update, delete: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    // 5. AVIS CLIENTS : Consultation publique, dépôt par les clients authentifiés
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
